{
  "nodes": [
    { "id": "llm", "name": "大语言模型", "module": "ai", "chapter": "/ch01_ai_foundation", "anchor": "_1-2-大语言模型原理", "desc": "基于 Transformer 的生成式模型，预训练加微调范式，是 Agent 的智能底座。" },
    { "id": "transformer", "name": "Transformer", "module": "ai", "chapter": "/ch01_ai_foundation", "anchor": "transformer-架构", "desc": "Google 2017 年提出的基础架构，自注意力加前馈网络，配残差连接和层归一化。" },
    { "id": "attention", "name": "自注意力", "module": "ai", "chapter": "/ch01_ai_foundation", "anchor": "transformer-架构", "desc": "计算序列元素间的关联权重，捕获长距离依赖，是多头注意力的基础。" },
    { "id": "mha", "name": "多头注意力 MHA", "module": "ai", "chapter": "/ch01_ai_foundation", "anchor": "注意力变体", "desc": "标准多头注意力，每头独立 QKV 在多个子空间并行计算，能力强但 KV 缓存和计算开销大。" },
    { "id": "mla", "name": "MLA 多头潜在注意力", "module": "ai", "chapter": "/ch01_ai_foundation", "anchor": "注意力变体", "desc": "DeepSeek 提出的低秩 KV 压缩注意力，缓存低维潜变量、推理时展开，KV Cache 大幅降低。" },
    { "id": "kv-cache", "name": "KV Cache", "module": "ai", "chapter": "/ch01_ai_foundation", "anchor": "kv-cache", "desc": "缓存已生成 Token 的 Key/Value 矩阵，避免重复计算，显著提升推理速度。" },
    { "id": "token", "name": "Token", "module": "ai", "chapter": "/ch01_ai_foundation", "anchor": "token-与分词", "desc": "文本切分后的最小处理单元，一个中文词通常对应 1 个 Token。" },
    { "id": "embedding", "name": "Embedding", "module": "ai", "chapter": "/ch01_ai_foundation", "anchor": "embedding-模型", "desc": "把文本映射为向量，语义相近的文本向量距离更近，是 RAG 检索的基础。" },
    { "id": "quant", "name": "量化", "module": "ai", "chapter": "/ch01_ai_foundation", "anchor": "量化", "desc": "把浮点权重映射为低精度整数，降低存储和推理资源需求，可能带来精度损失。" },
    { "id": "vram", "name": "显存", "module": "ai", "chapter": "/ch01_ai_foundation", "anchor": "精度与显存", "desc": "决定能装载的模型参数和数据量，推理显存由权重、KV Cache 和激活值组成。" },
    { "id": "moe", "name": "MoE", "module": "ai", "chapter": "/ch01_ai_foundation", "anchor": "moe-混合专家", "desc": "混合专家，每次推理只激活部分专家网络，总参数量大但计算量小。" },
    { "id": "grad", "name": "梯度下降", "module": "ai", "chapter": "/ch01_ai_foundation", "anchor": "梯度下降与学习率", "desc": "依据梯度和学习率更新参数，学习率过大会震荡发散。" },
    { "id": "supervised", "name": "监督学习", "module": "ai", "chapter": "/ch01_ai_foundation", "anchor": "学习范式", "desc": "使用带标签样本学习输入到目标的映射，与无监督、强化学习并列。" },
    { "id": "svm", "name": "SVM 支持向量机", "module": "ai", "chapter": "/ch01_ai_foundation", "anchor": "支持向量机与朴素贝叶斯", "desc": "寻找最大间隔分类超平面，由少数支持向量决定，配合核技巧处理非线性，适合高维小样本。" },
    { "id": "naive-bayes", "name": "朴素贝叶斯", "module": "ai", "chapter": "/ch01_ai_foundation", "anchor": "支持向量机与朴素贝叶斯", "desc": "基于特征条件独立假设，用贝叶斯定理计算类别后验概率，取最大者作为预测，常用于文本分类。" },
    { "id": "top-p", "name": "Top-p 采样", "module": "ai", "chapter": "/ch01_ai_foundation", "anchor": "解码策略", "desc": "按累计概率阈值动态选取候选 Token 集合，候选数随分布变化。" },
    { "id": "agent", "name": "Agent", "module": "agent", "chapter": "/ch04_agent", "anchor": "_4-2-agent-架构与闭环", "desc": "围绕目标理解、决策和行动，形成目标计划行动观察判断的闭环。" },
    { "id": "react", "name": "ReAct", "module": "agent", "chapter": "/ch04_agent", "anchor": "_4-15-react", "desc": "推理与行动交织，思考行动观察循环，Observation 承接工具返回结果。" },
    { "id": "planning", "name": "Planning", "module": "agent", "chapter": "/ch04_agent", "anchor": "_4-3-planning-规划", "desc": "把复杂目标拆成可验证子任务，随执行结果动态调整。" },
    { "id": "tool", "name": "工具调用", "module": "agent", "chapter": "/ch04_agent", "anchor": "_4-4-工具调用", "desc": "依据工具描述和 Schema 生成参数，由外部执行层真正调用。" },
    { "id": "memory", "name": "记忆", "module": "agent", "chapter": "/ch04_agent", "anchor": "_4-5-记忆", "desc": "短期记忆在上下文窗口内，长期记忆依赖外部持久化存储。" },
    { "id": "rag", "name": "RAG", "module": "agent", "chapter": "/ch04_agent", "anchor": "_4-6-rag-与向量检索", "desc": "检索增强生成，推理时检索外部知识注入上下文，解决知识有限问题。" },
    { "id": "mcp", "name": "MCP", "module": "agent", "chapter": "/ch04_agent", "anchor": "_4-7-mcp", "desc": "模型上下文协议，统一工具接口标准，Server 提供 Tool，Client 负责连接。" },
    { "id": "skill", "name": "Skill", "module": "agent", "chapter": "/ch04_agent", "anchor": "_4-8-skill", "desc": "封装可复用的高层任务能力，抽象层级高于单个底层 Tool。" },
    { "id": "multi-agent", "name": "多智能体", "module": "agent", "chapter": "/ch04_agent", "anchor": "_4-12-多智能体协作", "desc": "多 Agent 角色分工协作，会引入通信和协调开销。" },
    { "id": "prompt", "name": "Prompt 工程", "module": "agent", "chapter": "/ch04_agent", "anchor": "_4-20-prompt-工程", "desc": "系统提示词设定角色规则，Few-shot 示例和思维链提升效果。" },
    { "id": "agent-safety", "name": "Agent 安全", "module": "agent", "chapter": "/ch04_agent", "anchor": "_4-13-安全", "desc": "应对提示注入、越权工具调用和不可逆操作，高风险动作前人工确认。" },
    { "id": "cot", "name": "CoT 思维链", "module": "agent", "chapter": "/ch04_agent", "anchor": "_4-9-cot", "desc": "引导模型逐步推理再作答的提示技术，Few-shot 与 Zero-shot 形式可提升复杂推理表现。" },
    { "id": "llm-principle", "name": "Transformer（大语言模型原理）", "module": "ai", "chapter": "/ch04_agent", "anchor": "_4-10-transformer", "desc": "大语言模型的 Transformer 原理，注意力与 Decoder-only 结构，Token 与上下文窗口决定 Agent 能力边界。" },
    { "id": "agent-framework", "name": "智能体开发框架", "module": "agent", "chapter": "/ch04_agent", "anchor": "_4-11-智能体开发框架-langchain-react-function-calling", "desc": "LangChain、LangGraph 等框架与 ReAct、Function Calling，提供工具集成、记忆与编排能力。" },
    { "id": "uos", "name": "UOS", "module": "os", "chapter": "/ch02_os_linux", "anchor": "linux-与-uos", "desc": "统信基于 Linux 内核的国产操作系统，面向国产 CPU 平台。" },
    { "id": "kernel", "name": "Linux 内核", "module": "os", "chapter": "/ch02_os_linux", "anchor": "内核", "desc": "运行在特权模式的核心程序，管理进程、内存、文件、设备与权限，系统调用是其入口。" },
    { "id": "process", "name": "进程与线程", "module": "os", "chapter": "/ch02_os_linux", "anchor": "进程与线程", "desc": "进程是资源分配单位，线程共享地址空间，服务由进程实现。" },
    { "id": "perm", "name": "文件权限", "module": "os", "chapter": "/ch02_os_linux", "anchor": "_2-5-文件系统与权限", "desc": "读读写执行三种权限，umask 影响新建文件默认权限。" },
    { "id": "systemd", "name": "systemd", "module": "os", "chapter": "/ch02_os_linux", "anchor": "systemd-与服务管理", "desc": "服务管理器，status 查看状态，enable 配置开机自启。" },
    { "id": "network", "name": "网络", "module": "os", "chapter": "/ch02_os_linux", "anchor": "_2-8-网络", "desc": "连通性依赖子网、网关、路由、DNS 和监听地址。" },
    { "id": "pkg", "name": "软件包管理", "module": "os", "chapter": "/ch02_os_linux", "anchor": "_2-9-软件包管理与生态适配", "desc": "依赖软件源、包索引、依赖版本，依赖冲突先查一致性。" },
    { "id": "swap", "name": "swap", "module": "os", "chapter": "/ch02_os_linux", "anchor": "swap", "desc": "磁盘上的交换空间，内存压力下提供辅助虚拟内存。" },
    { "id": "shell", "name": "Shell", "module": "os", "chapter": "/ch02_os_linux", "anchor": "_2-3-shell-与命令基础", "desc": "命令行解释器，管道重定向和脚本是系统操作基础。" },
    { "id": "boot", "name": "Linux 启动流程", "module": "os", "chapter": "/ch02_os_linux", "anchor": "_2-2-linux-启动流程", "desc": "固件→GRUB→内核→systemd 一号进程的接力启动，排障看 dmesg/journalctl。" },
    { "id": "signal", "name": "信号", "module": "os", "chapter": "/ch02_os_linux", "anchor": "信号机制", "desc": "SIGTERM 可捕获清理，SIGKILL 内核强制终止不可捕获。" },
    { "id": "dns", "name": "DNS", "module": "os", "chapter": "/ch02_os_linux", "anchor": "dns-解析", "desc": "域名解析为 IP，配置在 /etc/resolv.conf。" },
    { "id": "raid", "name": "RAID", "module": "os", "chapter": "/ch02_os_linux", "anchor": "raid-与数据备份", "desc": "磁盘组合成逻辑卷，RAID0/1/5，防硬件故障不防误删。" },
    { "id": "db", "name": "数据库", "module": "software", "chapter": "/ch03_software", "anchor": "_3-1-数据库基础", "desc": "用表组织数据，主键唯一标识，外键建立表间关联。" },
    { "id": "nosql", "name": "NoSQL", "module": "software", "chapter": "/ch03_software", "anchor": "nosql-数据库", "desc": "键值、文档、宽列族、图四类，键值适合快速读写简单状态。" },
    { "id": "txn", "name": "事务", "module": "software", "chapter": "/ch03_software", "anchor": "_1-事务", "desc": "ACID 原子性要求操作要么全部成功要么整体失败。" },
    { "id": "index", "name": "索引", "module": "software", "chapter": "/ch03_software", "anchor": "_2-索引", "desc": "加速特定查询，但会增加写入和维护成本。" },
    { "id": "middleware", "name": "中间件", "module": "software", "chapter": "/ch03_software", "anchor": "_3-3-中间件", "desc": "位于操作系统与业务应用之间，提供通信、事务、消息、服务治理。" },
    { "id": "mq", "name": "消息队列", "module": "software", "chapter": "/ch03_software", "anchor": "消息队列", "desc": "异步解耦和削峰缓冲，可靠处理靠确认、重试、幂等、死信。" },
    { "id": "docker", "name": "容器", "module": "software", "chapter": "/ch03_software", "anchor": "_3-4-虚拟机与容器", "desc": "共享宿主机内核，打包应用与依赖，实现环境一致。" },
    { "id": "gpu", "name": "GPU", "module": "hardware", "chapter": "/ch05_hardware", "anchor": "_5-4-gpu-架构与-cuda", "desc": "适合大规模并行计算，SM 调度线程，Tensor Core 加速矩阵运算。" },
    { "id": "npu", "name": "NPU", "module": "hardware", "chapter": "/ch05_hardware", "anchor": "计算单元定位", "desc": "神经网络专用加速器，低功耗，面向特定负载。" },
    { "id": "cuda", "name": "CUDA", "module": "hardware", "chapter": "/ch05_hardware", "anchor": "cuda-编程模型", "desc": "GPU 编程事实标准，Grid-Block-Thread 线程组织。" },
    { "id": "hetero", "name": "异构计算", "module": "hardware", "chapter": "/ch05_hardware", "anchor": "_5-3-异构计算", "desc": "CPU 与不同加速单元按任务特点协同配合。" },
    { "id": "liquid", "name": "液冷", "module": "hardware", "chapter": "/ch05_hardware", "anchor": "_5-7-液冷与散热技术", "desc": "冷板液冷属间接接触式，支持高功耗芯片，CDU 负责分配与换热。" },
    { "id": "iluvatar", "name": "天数智芯", "module": "hardware", "chapter": "/ch05_hardware", "anchor": "天数智芯", "desc": "国产通用 GPU 供应商，天垓训练、智铠推理、彤央边端。" },
    { "id": "isa", "name": "ISA/ABI", "module": "hardware", "chapter": "/ch05_hardware", "anchor": "_5-2-兼容性层次", "desc": "指令集架构定义机器指令，跨架构二进制需重新编译。" }
  ],
